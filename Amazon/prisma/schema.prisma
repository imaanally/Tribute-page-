
generator client {
  provider                    = "prisma-client-py"
  enable_experimental_decimal = "true"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Member {
  id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String          @db.VarChar(250)
  email     String          @unique @db.VarChar(250)
  phone     String          @unique @db.VarChar(50)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  password  MemberPassword?
  orders    Order[]

  @@map("member")
}

model MemberPassword {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId  String   @unique @map("member_id") @db.Uuid
  password  String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  member    Member   @relation(fields: [memberId], references: [id])

  @@map("member_password")
}

model Product {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String         @db.VarChar(250)
  description   String?
  buyingPrice   Decimal        @map("buying_price") @db.Decimal
  sellingPrice  Decimal        @map("selling_price") @db.Decimal
  quantity      Int
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  orderProducts OrderProduct[]
  images        ProductImage[]

  @@map("product")
}

model OrderStatus {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String   @db.VarChar(100)
  description     String?
  icon            String?
  backgroundColor String?  @map("background_color") @db.VarChar(50)
  textColor       String?  @map("text_color") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  orders          Order[]

  @@map("order_status")
}

model Order {
  id                String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  memberId          String         @map("member_id") @db.Uuid
  totalItems        Int?           @map("total_items")
  totalSellingPrice Decimal        @map("total_selling_price") @db.Decimal
  totalPaid         Decimal        @map("total_paid") @db.Decimal
  orderStatusId     String         @map("order_status_id") @db.Uuid
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime       @default(now()) @map("updated_at") @db.Timestamptz(6)
  member            Member         @relation(fields: [memberId], references: [id])
  orderStatus       OrderStatus    @relation(fields: [orderStatusId], references: [id])
  orderProducts     OrderProduct[]

  @@map("order")
}

model OrderProduct {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId           String   @map("order_id") @db.Uuid
  productId         String   @map("product_id") @db.Uuid
  quantity          Int
  unitPrice         Decimal  @map("unit_price") @db.Decimal
  totalSellingPrice Decimal  @map("total_selling_price") @db.Decimal
  totalBuyingPrice  Decimal  @map("total_buying_price") @db.Decimal
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order             Order    @relation(fields: [orderId], references: [id])
  product           Product  @relation(fields: [productId], references: [id])

  @@map("order_product")
}

model ProductImage {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  image     String
  isDefault Boolean? @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id])

  @@map("product_image")
}
